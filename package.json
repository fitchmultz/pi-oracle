{
  "name": "omp-oracle",
  "version": "0.4.11",
  "description": "Asynchronous ChatGPT and Grok web-oracle jobs for Oh My Pi and pi: isolated browser auth, durable background jobs, and project-context archives.",
  "private": false,
  "license": "MIT",
  "author": "alphastorm (https://github.com/alphastorm)",
  "contributors": [
    "Mitch Fultz (https://github.com/fitchmultz)"
  ],
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "omp",
    "oh-my-pi",
    "extension",
    "chatgpt",
    "grok",
    "oracle"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alphastorm/omp-oracle.git"
  },
  "bugs": {
    "url": "https://github.com/alphastorm/omp-oracle/issues"
  },
  "homepage": "https://github.com/alphastorm/omp-oracle#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "extensions",
    "prompts",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "platform-smoke.config.mjs",
    "scripts/platform-smoke.mjs",
    "scripts/platform-smoke",
    "scripts/oracle-real-smoke.mjs",
    "scripts/oracle-chatgpt-preset-proof.mjs"
  ],
  "pi": {
    "extensions": [
      "./extensions/oracle/index.ts"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "scripts": {
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:oracle-extension": "npm run check:syntax && esbuild extensions/oracle/index.ts --bundle --platform=node --format=esm --external:@earendil-works/pi-ai --external:@earendil-works/pi-coding-agent --external:typebox --outfile=/tmp/pi-oracle-extension-check.js",
    "test:oracle-helpers": "node --test scripts/oracle-host-compat.test.mjs scripts/oracle-native.test.mjs extensions/oracle/shared/relay-browser-helpers.test.mjs extensions/oracle/shared/managed-browser-helpers.test.mjs extensions/oracle/worker/auth-flow-helpers.test.mjs extensions/oracle/worker/chatgpt-ui-helpers.test.mjs extensions/oracle/worker/response-capture.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:worker-helpers": "tsc --noEmit -p tsconfig.worker-helpers.json",
    "typecheck:worker-runtime": "tsc --noEmit -p tsconfig.worker-runtime.json",
    "sanity:oracle": "node scripts/oracle-sanity-runner.mjs",
    "pack:check": "npm pack --dry-run",
    "verify:oracle": "npm run check:oracle-extension && npm run check:platform-smoke && npm run test:oracle-helpers && npm run test:site && npm run test:docs && npm run typecheck && npm run typecheck:worker-helpers && npm run typecheck:worker-runtime && npm run sanity:oracle && npm run pack:check",
    "test:site": "node --test scripts/site-coherence.test.mjs",
    "test:docs": "node --test scripts/docs-links.test.mjs",
    "render:assets": "node scripts/render-assets.mjs",
    "test": "npm run verify:oracle",
    "prepublishOnly": "npm run release:check",
    "check:platform-smoke": "node scripts/platform-smoke/invariants.mjs",
    "smoke:platform": "node scripts/platform-smoke.mjs",
    "smoke:platform:doctor": "node scripts/platform-smoke.mjs doctor",
    "smoke:platform:ubuntu": "node scripts/platform-smoke.mjs run --target ubuntu",
    "smoke:platform:all": "npm run smoke:platform:doctor && node scripts/platform-smoke.mjs run --target macos,ubuntu",
    "smoke:platform:macos": "node scripts/platform-smoke.mjs run --target macos",
    "smoke:platform:windows-native": "node scripts/platform-smoke.mjs run --target windows-native",
    "smoke:real": "npm run smoke:real:packed",
    "smoke:real:doctor": "node scripts/oracle-real-smoke.mjs doctor",
    "release:check": "npm run verify:oracle && npm run release:proof:chatgpt-presets && npm run smoke:platform:all",
    "proof:capture": "node scripts/oracle-capture-proof.mjs",
    "release:proof:chatgpt-presets": "node scripts/oracle-chatgpt-preset-proof.mjs check",
    "release:proof:chatgpt-presets:run": "node scripts/oracle-chatgpt-preset-proof-run.mjs",
    "smoke:real:packed": "node scripts/oracle-real-smoke.mjs run --mode packed",
    "smoke:real:source": "node scripts/oracle-real-smoke.mjs run --mode source",
    "sanity:oracle:platform": "node scripts/oracle-sanity-runner.mjs --mode platform",
    "verify:oracle:platform": "npm run check:oracle-extension && npm run check:platform-smoke && npm run sanity:oracle:platform && npm run pack:check"
  },
  "dependencies": {
    "@steipete/sweet-cookie": "^0.4.4"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.3.0",
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@types/node": "^22.19.19",
    "esbuild": "^0.28.2",
    "tsx": "^4.22.3",
    "typebox": "^1.3.27",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "undici": "8.12.2",
    "minimatch": "^11.0.1"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "packageManager": "npm@11.16.0",
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "allowScripts": {
    "esbuild": false,
    "protobufjs": false,
    "@google/genai": false,
    "fsevents": false
  }
}
